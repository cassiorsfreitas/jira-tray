{
  "name": "jira-tray",
  "productName": "Jira Tray",
  "version": "1.0.0",
  "private": true,
  "description": "macOS menu bar app that shows the Jira tickets assigned to you, grouped by due date",
  "keywords": [
    "jira",
    "menu-bar",
    "tray",
    "macos",
    "electron"
  ],
  "license": "MIT",
  "homepage": "https://github.com/cassiorsfreitas/jira-tray#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cassiorsfreitas/jira-tray.git"
  },
  "bugs": {
    "url": "https://github.com/cassiorsfreitas/jira-tray/issues"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "author": {
    "name": "Cássio Freitas",
    "email": "cassio.rsfreitas@gmail.com"
  },
  "main": ".vite/build/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "release": "electron-forge release",
    "lint": "oxlint && oxfmt --check",
    "lint:fix": "oxlint --fix && oxfmt --write",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate-icons": "node scripts/generate-icons.mjs",
    "generate-app-icon": "node scripts/generate-app-icon.mjs"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@electron-forge/plugin-auto-unpack-natives": "^8.0.1",
    "@electron-forge/plugin-fuses": "^8.0.1",
    "@electron-forge/plugin-vite": "^8.0.1",
    "@electron/fuses": "^2.1.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "44.9.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.88.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
